{
  "name": "spec-workflow-mcp",
  "version": "3.1.0",
  "description": "MCP server for spec-driven development with harness-owned verification and Telegram control",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "spec-workflow-mcp": "dist/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run clean && tsc && node scripts/copy-static.cjs",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:loop": "bash scripts/test-loop-l1.sh",
    "test:loop:l2": "bash scripts/test-loop-l2.sh",
    "test:loop:l3": "bash scripts/test-loop-l3.sh",
    "test:loop:l4": "bash scripts/test-loop-l4.sh",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test:loop:l5": "bash scripts/test-loop-l5-gates.sh"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "spec-workflow",
    "ai-development",
    "claude",
    "cursor",
    "development-workflow",
    "project-management",
    "telegram",
    "harness"
  ],
  "author": "",
  "license": "GPL-3.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.3",
    "@toon-format/toon": "^0.8.0",
    "toml": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "@vitest/coverage-v8": "^4.0.15",
    "rimraf": "^6.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.7.2",
    "vitest": "^4.0.15"
  }
}
